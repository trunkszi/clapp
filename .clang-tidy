Checks: >
  -*,
  bugprone-*,                # Detect bug-prone code patterns
  cert-*,                    # CERT secure coding standards
  clang-analyzer-*,          # Clang static analyzer checks
  concurrency-*,             # Concurrency and thread safety issues
  cppcoreguidelines-*,       # C++ Core Guidelines
  google-*,                  # Google C++ style guide
  hicpp-*,                   # High Integrity C++ coding standard
  modernize-*,               # Modern C++ feature suggestions
  performance-*,             # Performance optimization opportunities
  readability-*,             # Code readability improvements
  -readability-braces-around-statements,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-redundant-declaration,
  -readability-avoid-return-with-void-value,
  -readability-function-cognitive-complexity,
  -bugprone-easily-swappable-parameters,                    # Too many false positives
  -bugprone-implicit-widening-of-multiplication-result,     # Too many false positives
  -bugprone-narrowing-conversions,                          # Too many false positives
  -bugprone-unchecked-optional-access,                      # Too many false positives in tests
  -cppcoreguidelines-avoid-c-arrays,                        # C arrays are sometimes appropriate
  -cppcoreguidelines-avoid-magic-numbers,                   # Duplicate of readability-magic-numbers
  -cppcoreguidelines-non-private-member-variables-in-classes, # POD structs need public members
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,     # Too restrictive for our use cases
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,         # Too restrictive for our use cases
  -cppcoreguidelines-pro-type-reinterpret-cast,             # Sometimes necessary for low-level code
  -modernize-use-trailing-return-type,                      # Less readable in our opinion
  -modernize-concat-nested-namespaces,                      # Need to support C++14
  -modernize-use-nodiscard,                                 # Need to support C++14
  -modernize-return-braced-init-list,                       # Can hurt readability
  -modernize-avoid-c-arrays,                                # Duplicate of cppcoreguidelines-avoid-c-arrays
  -performance-move-const-arg,                              # Too many false positives
  -performance-avoid-endl,                                  # Too many legitimate uses in samples
  -performance-enum-size,                                   # Architecture dependent
  -hicpp-avoid-c-arrays,                                    # Duplicate of cppcoreguidelines-avoid-c-arrays
  -hicpp-braces-around-statements,                          # Duplicate of readability-braces-around-statements
  -hicpp-named-parameter,                                   # Duplicate of readability-named-parameter
  -hicpp-no-array-decay,                                    # Duplicate of cppcoreguidelines-pro-bounds-array-to-pointer-decay
  -google-readability-namespace-comments,                   # Conflicts with macro usage


WarningsAsErrors: "*"
HeaderFilterRegex: '.*/clapp/.*'
FormatStyle: file
SystemHeaders: false

CheckOptions:
  - { key: readability-identifier-naming.NamespaceCase,          value: lower_case }
  - { key: readability-identifier-naming.ClassCase,              value: CamelCase }
  - { key: readability-identifier-naming.StructCase,             value: CamelCase }
  - { key: readability-identifier-naming.TemplateParameterCase,  value: CamelCase }
  - { key: readability-identifier-naming.FunctionCase,           value: CamelCase }
  - { key: readability-identifier-naming.VariableCase,           value: lower_case }
  - { key: readability-identifier-naming.ClassMemberCase,        value: lower_case }
  - { key: readability-identifier-naming.ClassMemberSuffix,      value: _ }
  - { key: readability-identifier-naming.PrivateMemberSuffix,    value: _ }
  - { key: readability-identifier-naming.ProtectedMemberSuffix,  value: _ }
  - { key: readability-identifier-naming.EnumConstantCase,         value: CamelCase }
  - { key: readability-identifier-naming.EnumConstantPrefix,       value: k }
  - { key: readability-identifier-naming.ConstexprVariableCase,    value: CamelCase }
  - { key: readability-identifier-naming.ConstexprVariablePrefix,  value: k }
  - { key: readability-identifier-naming.GlobalConstantCase,       value: CamelCase }
  - { key: readability-identifier-naming.GlobalConstantPrefix,     value: k }
  - { key: readability-identifier-naming.MemberConstantCase,       value: CamelCase }
  - { key: readability-identifier-naming.MemberConstantPrefix,     value: k }
  - { key: readability-identifier-naming.StaticConstantCase,       value: CamelCase }
  - { key: readability-identifier-naming.StaticConstantPrefix,     value: k }
  - { key: readability-implicit-bool-conversion.AllowIntegerConditions,  value: 1 }
  - { key: readability-implicit-bool-conversion.AllowPointerConditions,  value: 1 }
  - { key: readability-function-cognitive-complexity.IgnoreMacros,  value: 1 }
